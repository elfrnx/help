{
  "manifest_version": 3,
  "name": "PulseScout",
  "version": "1.0",
  "description": "CV ve LinkedIn becerilerine gore uygun is ilanlarini kesfet",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "tabs", "sidePanel", "scripting"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "action": {
    "default_title": "PulseScout",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://www.linkedin.com/jobs/*", "https://www.linkedin.com/in/*"],
    "js": ["content.js"],
    "css": ["content.css"]
  }]
}
